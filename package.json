{
  "name": "gotit-front",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "test": "vitest run",
    "start": "node server/gateway.mjs",
    "test:gateway": "node --test test/gateway.test.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run build && npm run test:gateway"
  },
  "dependencies": {
    "@paddle/paddle-js": "^1.6.5",
    "@vitejs/plugin-react": "^5.0.4",
    "i18next": "^26.4.2",
    "lucide-react": "^0.544.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-i18next": "^17.0.15",
    "react-router-dom": "^7.9.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^16.4.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  }
}
