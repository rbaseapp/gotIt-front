# rbase Core authentication service
VITE_CORE_API_URL=/core-api
CORE_API_PROXY_TARGET=https://rbase-core-api.onrender.com

# Independent GotIt product service. Local port is configurable; production URL is not documented.
VITE_GOTIT_API_URL=/gotit-api
GOTIT_API_PROXY_TARGET=http://localhost:3001

# Keep true while vocabulary/practice APIs B2-B8 are not available.
VITE_DEMO_MODE=true
