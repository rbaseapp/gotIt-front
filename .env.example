# rbase Core authentication service
VITE_CORE_API_URL=/core-api
CORE_API_PROXY_TARGET=https://rbase-core-api.onrender.com

# Independent GotIt product service. Use http://localhost:3001 for local backend development.
VITE_GOTIT_API_URL=/gotit-api
GOTIT_API_PROXY_TARGET=https://gotit-backend.onrender.com

# Public OAuth web client identifier. Must match the GotIt application configuration in Core.
VITE_GOOGLE_CLIENT_ID=336996428812-7372mensreravb06t04cr9t2c5mbgcdo.apps.googleusercontent.com
# Public Meta application identifier. The App Secret belongs only in Core's FACEBOOK_APP_SECRETS.
VITE_FACEBOOK_APP_ID=
VITE_DEMO_MODE=false
VITE_PADDLE_CLIENT_TOKEN=
VITE_PADDLE_ENVIRONMENT=sandbox
VITE_PADDLE_PRO_MONTHLY_PRICE_ID=
VITE_PADDLE_PRO_YEARLY_PRICE_ID=
PADDLE_CLIENT_TOKEN=
PADDLE_ENVIRONMENT=sandbox
PADDLE_PRO_MONTHLY_PRICE_ID=
PADDLE_PRO_YEARLY_PRICE_ID=

# Production gateway, set to the actual HTTPS website origin (Render also supplies RENDER_EXTERNAL_URL).
PUBLIC_APP_ORIGIN=
PORT=10000
# Never add Google Translation API keys, OAuth client secrets, or database credentials to VITE_* variables.
